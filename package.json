{
  "name": "@ieportals/porkbun-provider",
  "version": "1.1.0",
  "description": "A tiny TypeScript helper for creating and deleting Porkbun CNAME and TXT records.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "22.19.11",
    "dotenv": "16.4.7",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
